<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/geiss_bg">

    <!-- Full-screen Live Geiss OpenGL ES 2.0 Canvas -->
    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Status HUD -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvModeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Mode 01: Classic Spiral"
                    android:textColor="@color/geiss_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="8-bit · 60 FPS · Wave 1"
                    android:textColor="@color/geiss_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetWallpaper"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Set Wallpaper"
                android:textColor="#04131A"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/geiss_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Settings"
                android:textColor="@color/geiss_text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/geiss_border" />
        </LinearLayout>

        <!-- Second row: Audio status pill + Track title + Hide HUD button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAudioBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Audio: Output Mix"
                android:textColor="@color/geiss_green"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHideHud"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Clean View"
                android:textColor="@color/geiss_text_secondary"
                android:textSize="11sp"
                app:strokeColor="@color/geiss_border" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Restore Controls Button when HUD hidden -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShowHud"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Show Controls"
        android:textColor="@color/geiss_text_primary"
        android:textSize="12sp"
        android:visibility="gone"
        app:backgroundTint="#A012172A" />

    <!-- Bottom Interactive Geiss Control Deck -->
    <LinearLayout
        android:id="@+id/bottomHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_dock_glass"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Row 1: Primary Map / Palette / Lock Hotkeys -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextMap"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Next Map"
                    android:textColor="@color/geiss_cyan"
                    android:textSize="12sp"
                    app:backgroundTint="@color/geiss_surface_elevated" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRandomPalette"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Palette"
                    android:textColor="@color/geiss_text_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/geiss_surface_elevated" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLockMap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Lock Map"
                    android:textSize="12sp"
                    app:strokeColor="@color/geiss_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLockPalette"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Lock Pal"
                    android:textSize="12sp"
                    app:strokeColor="@color/geiss_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSlideShift"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Shift"
                    android:textSize="12sp"
                    app:strokeColor="@color/geiss_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSongPopup"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Popup"
                    android:textSize="12sp"
                    app:strokeColor="@color/geiss_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshEdges"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Edges"
                    android:textSize="12sp"
                    app:strokeColor="@color/geiss_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHdrToggle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="HDR"
                    android:textSize="12sp"
                    app:strokeColor="@color/geiss_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVibrancy"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Vivid"
                    android:textSize="12sp"
                    app:strokeColor="@color/geiss_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActionWheel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Wheel"
                    android:textColor="@color/geiss_cyan"
                    android:textSize="12sp"
                    app:backgroundTint="@color/geiss_surface_elevated" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 2: Waveform + Spectrum + Wave Sensitivity Scale -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWaveform"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Wave 1"
                android:textSize="11sp"
                app:strokeColor="@color/geiss_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpectrum"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Spectrum"
                android:textSize="11sp"
                app:strokeColor="@color/geiss_border" />

            <TextView
                android:id="@+id/tvVolLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gain 10"
                android:textColor="@color/geiss_text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekVolumePos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="10" />
        </LinearLayout>

        <!-- Row 3: All 8 Classic Geiss Effects -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/effectsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Row 4: Modes/Ratings, Presets 00-99, Custom Messages 00-99, Audio Source -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModesDialog"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="25 Modes &amp; ★"
                    android:textSize="12sp"
                    app:backgroundTint="@color/geiss_surface_elevated" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetsDialog"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Presets 00-99"
                    android:textSize="12sp"
                    app:backgroundTint="@color/geiss_surface_elevated" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMessagesDialog"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Messages 00-99"
                    android:textSize="12sp"
                    app:backgroundTint="@color/geiss_surface_elevated" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAudioSourceDialog"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Audio Source"
                    android:textSize="12sp"
                    app:backgroundTint="@color/geiss_surface_elevated" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Interactive Radial Action Wheel Overlay -->
    <com.geisswerks.geiss.GeissActionWheelView
        android:id="@+id/actionWheelView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
